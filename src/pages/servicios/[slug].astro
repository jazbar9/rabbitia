---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { WA_LINK, SITE } from "../../lib/site";
import { servicios } from "../../lib/services";

export function getStaticPaths() {
	return servicios.map(({ slug }) => ({ params: { slug } }));
}

const slug = Astro.params.slug as string;
const service = servicios.find((s) => s.slug === slug)!;
const otros = servicios.filter((s) => s.slug !== slug);

const { titulo, kicker, descripcion, descripcionLarga, entregables, icon } = service;
const title = `${titulo} — ${SITE.name}`;
---

<Layout title={title} description={service.metaDesc}>
	<article class="noise-overlay relative overflow-hidden bg-white">
		<div
			class="pointer-events-none absolute inset-0 bg-gradient-to-br from-white via-lime/5 to-white"
			aria-hidden="true"
		></div>
		<div
			class="pointer-events-none absolute top-20 left-10 h-28 w-28 rounded-full bg-lime/20 blur-3xl"
			aria-hidden="true"
		></div>

		<div class="relative z-10 mx-auto w-full max-w-4xl px-6 pt-32 pb-16 md:pt-40 md:pb-24">
			<nav aria-label="Migajas de página">
				<a
					href="/servicios"
					class="inline-flex items-center gap-2 font-mono text-xs text-ink/50 transition-colors hover:text-ink"
				>
					<svg
						viewBox="0 0 24 24"
						class="h-3 w-3"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M7 8l-4 4m0 0l4 4m-4-4h18" />
					</svg>
					Todos los servicios
				</a>
			</nav>

			<div class="mt-6 space-y-6">
				<span
					class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-lime text-ink shadow-lg"
					aria-hidden="true"
					data-reveal
				>
					<Icon name={icon} />
				</span>

				<span class="kicker block text-ink/60" data-reveal style="--rd: 0.1s">
					{kicker}
				</span>
				<h1 class="display lines text-4xl text-ink md:text-6xl">
					<span class="line">
						<span>{titulo}</span>
					</span>
				</h1>
				<p
					class="max-w-xl font-mono text-base text-ink/60 md:text-lg"
					data-reveal
					style="--rd: 0.2s"
				>
					{descripcion}
				</p>
			</div>
		</div>
	</article>

	<section class="relative overflow-hidden bg-[#f3f3e0] py-16 md:py-24" aria-labelledby="detalle-title">
		<div class="mx-auto w-full max-w-4xl px-6">
			<div class="grid gap-10 md:grid-cols-5">
				<div class="md:col-span-3" data-reveal>
					<h2 id="detalle-title" class="display text-2xl tracking-tight text-ink md:text-3xl">
						En qué consiste
					</h2>
					<p class="mt-4 font-mono text-sm leading-relaxed text-ink/60 md:text-base">
						{descripcionLarga}
					</p>
				</div>

				<div class="md:col-span-2" data-reveal style="--rd: 0.15s">
					<div class="rounded-2xl border-2 border-ink/10 bg-white p-6 shadow-xl">
						<h3 class="kicker text-ink/60">Entregables</h3>
						<ul class="mt-4 space-y-3">
							{entregables.map((e) => (
								<li class="feature-dot flex items-start gap-3 font-mono text-sm text-ink/80">
									{e}
								</li>
							))}
						</ul>
					</div>
				</div>
			</div>

			<div
				class="mt-14 flex flex-col gap-3 rounded-[1.5rem] bg-ink p-8 md:flex-row md:items-center md:justify-between md:p-10"
				data-reveal
			>
				<div>
					<h3 class="display text-xl tracking-tight text-white md:text-2xl">
						¿Empezamos por <span class="text-lime">este frente?</span>
					</h3>
					<p class="mt-2 max-w-md font-mono text-xs text-white/60 md:text-sm">
						Contanos qué proceso te está robando tiempo. Una conversación de 15
						minutos, sin costo y con respuestas concretas.
					</p>
				</div>
				<a
					href={WA_LINK}
					target="_blank"
					rel="noopener"
					class="btn btn-lime shine group shrink-0"
				>
					Cotizar por WhatsApp
					<svg
						viewBox="0 0 24 24"
						class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M17 8l4 4m0 0l-4 4m4-4H3" />
					</svg>
				</a>
			</div>
		</div>
	</section>

	<section class="relative overflow-hidden bg-white py-16 md:py-24" aria-label="Otros servicios">
		<div class="mx-auto w-full max-w-4xl px-6">
			<h2 class="kicker text-ink/60" data-reveal>Otros servicios</h2>
			<div class="mt-6 grid gap-4 md:grid-cols-3">
				{otros.map((o, i) => (
					<a
						href={`/servicios/${o.slug}`}
						class="reveal-card group rounded-2xl border-2 border-ink/10 bg-white p-5 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:border-lime hover:shadow-xl"
						data-reveal
						style={`--rd: ${i * 0.1}s`}
					>
						<div
							class="flex h-9 w-9 items-center justify-center rounded-xl bg-lime text-ink transition-colors duration-300 group-hover:bg-ink group-hover:text-lime"
							aria-hidden="true"
						>
							<Icon name={o.icon} />
						</div>
						<h3 class="display mt-3 text-lg tracking-tight text-ink">{o.titulo}</h3>
						<p class="mt-1 font-mono text-xs text-ink/60">{o.descripcion}</p>
					</a>
				))}
			</div>
		</div>
	</section>
</Layout>