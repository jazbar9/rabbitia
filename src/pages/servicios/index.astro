---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { SITE } from "../../lib/site";
import { servicios } from "../../lib/services";

const title = `Servicios — ${SITE.name}`;
const desc =
	"Diagnóstico de Transformación Digital, Datos, Business Intelligence y Automatización y Software. Un solo socio para toda la transformación.";
---

<Layout title={title} description={desc}>
	<section
		class="noise-overlay relative overflow-hidden bg-white"
		aria-labelledby="servicios-page-title"
	>
		<div
			class="pointer-events-none absolute inset-0 bg-gradient-to-br from-white via-lime/5 to-white"
			aria-hidden="true"
		></div>
		<div
			class="pointer-events-none absolute top-20 right-10 h-28 w-28 rounded-full bg-lime/20 blur-3xl"
			aria-hidden="true"
		></div>
		<div
			class="pointer-events-none absolute bottom-40 left-10 h-32 w-32 rounded-full bg-lime/10 blur-3xl"
			aria-hidden="true"
		></div>

		<div class="relative z-10 mx-auto w-full max-w-7xl px-6 pt-32 pb-16 md:pt-40 md:pb-24">
			<div class="max-w-3xl space-y-6">
				<span
					class="kicker inline-flex w-fit items-center gap-2 rounded-full bg-ink px-3 py-1.5 text-white"
					data-reveal
				>
					<span class="h-2 w-2 rounded-full bg-lime" aria-hidden="true"></span>
					Servicios
				</span>

				<h1 class="display lines text-4xl text-ink md:text-6xl">
					<span class="line">
						<span>Un socio,</span>
					</span>
					<span class="line">
						<span class="text-lime">cuatro frentes</span>
					</span>
				</h1>

				<p
					class="max-w-xl font-mono text-base text-ink/60 md:text-lg"
					data-reveal
					style="--rd: 0.2s"
				>
					Empezá por el diagnóstico o directamente por la máquina. Cada frente se
					sostiene solo y se conecta con los demás con un mismo equipo.
				</p>
			</div>
		</div>
	</section>

	<section
		class="relative overflow-hidden bg-[#f3f3e0] py-16 md:py-24"
		aria-label="Lista de servicios"
	>
		<div class="mx-auto w-full max-w-7xl px-6">
			<div class="grid gap-6 md:grid-cols-2">
				{servicios.map((s, i) => (
					<a
						href={`/servicios/${s.slug}`}
						class="reveal-card group flex flex-col rounded-[1.5rem] border-2 border-ink/10 bg-white p-6 shadow-xl transition-all duration-300 hover:-translate-y-1 hover:border-lime hover:shadow-2xl md:p-8"
						data-reveal
						style={`--rd: ${i * 0.1}s`}
						aria-label={`Ver el servicio ${s.titulo}`}
					>
						<div class="flex items-start justify-between">
							<div
								class="flex h-11 w-11 items-center justify-center rounded-xl bg-lime text-ink transition-colors duration-300 group-hover:bg-ink group-hover:text-lime"
								aria-hidden="true"
							>
								<Icon name={s.icon} />
							</div>
							<span class="font-mono text-xs tracking-widest text-ink/40">
								{String(i + 1).padStart(2, "0")}
							</span>
						</div>

						<span class="kicker mt-6 text-ink/50">{s.kicker}</span>
						<h2 class="display mt-1 text-2xl tracking-tight text-ink md:text-3xl">
							{s.titulo}
						</h2>
						<p class="mt-3 flex-1 font-mono text-sm text-ink/60">{s.descripcion}</p>

						<ul class="mt-5 flex flex-wrap gap-2">
							{s.entregables.map((e) => (
								<li class="rounded-full bg-ink/5 px-2.5 py-1 font-mono text-xs text-ink/60">
									{e}
								</li>
							))}
						</ul>

						<span class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-ink transition-colors duration-300 group-hover:text-lemon">
							Ver el servicio
							<svg
								viewBox="0 0 24 24"
								class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M17 8l4 4m0 0l-4 4m4-4H3" />
							</svg>
						</span>
					</a>
				))}
			</div>
		</div>
	</section>
</Layout>