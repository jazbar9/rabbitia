---
import Icon from "./Icon.astro";
import { WA_LINK } from "../lib/site";

const audiencias = [
	{
		icon: "punto",
		titulo: "Pymes que crecen",
		desc: "Pocos recursos y mil procesos a mano. Automatizamos lo repetitivo para que tu equipo trabaje en lo que importa.",
	},
	{
		icon: "ciclo",
		titulo: "Operaciones & plantas",
		desc: "Órdenes, inventario, proveedores. Un solo panel donde hoy hay planillas cruzadas de un lado a otro.",
	},
	{
		icon: "dato",
		titulo: "Finanzas & administración",
		desc: "Conciliaciones, facturación, cierres. Menos errores de tipeo y cierres que bajan en horas, no en días.",
	},
	{
		icon: "ventana",
		titulo: "Equipos corporativos",
		desc: "Capacidad interna desbordada y sistemas viejos por integrar. Nos sumamos sin frenar la operación.",
	},
];
---

<section
	id="para-quien"
	class="relative scroll-mt-0 overflow-hidden bg-white py-16 md:py-24"
	aria-labelledby="para-quien-title"
>
	<div class="mx-auto w-full max-w-7xl px-6">
		<div class="text-center" data-reveal>
			<span class="kicker text-ink/60">Para quién</span>
			<h2 id="para-quien-title" class="display mt-2 text-3xl text-ink md:text-5xl">
				<span class="lines">
					<span class="line"><span>Hecho para</span></span>
					<span class="line"><span class="text-lime">operaciones reales</span></span>
				</span>
			</h2>
			<p
				class="mx-auto mt-2 max-w-xl font-mono text-sm text-ink/60"
				data-reveal
				style="--rd: 0.2s"
			>
				Trabajamos con empresas que tienen un problema concreto que resolver — no con
				búsquedas de tecnología por tecnología.
			</p>
		</div>

		<div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
			{audiencias.map((a, i) => (
				<article
					class="group relative cursor-pointer overflow-hidden rounded-2xl bg-ink p-6 transition-colors duration-300"
					data-reveal
					class:list="reveal-card"
					style={`--rd: ${i * 0.1}s`}
				>
					<div
						class="absolute inset-0 bg-lime/0 transition-colors duration-300 group-hover:bg-lime"
						aria-hidden="true"
					></div>
					<div class="relative z-10">
						<div
							class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-lime text-ink transition-colors duration-300 group-hover:bg-ink group-hover:text-lime"
							aria-hidden="true"
						>
							<Icon name={a.icon} />
						</div>
						<h3
							class="display mb-2 text-lg tracking-tight text-white transition-colors duration-300 group-hover:text-ink"
						>
							{a.titulo}
						</h3>
						<p
							class="font-mono text-xs leading-relaxed text-white/60 transition-colors duration-300 group-hover:text-ink/60"
						>
							{a.desc}
						</p>
					</div>
				</article>
			))}
		</div>

		<div class="mt-10 text-center" data-reveal>
			<p class="font-mono text-sm text-ink/60">
				¿Tu caso no está en la lista? Contanos qué proceso te está robando tiempo.
			</p>
			<a
				href={WA_LINK}
				target="_blank"
				rel="noopener"
				class="btn btn-lime shine mt-5"
			>
				Contanos tu caso
				<svg
					viewBox="0 0 24 24"
					class="h-4 w-4"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M17 8l4 4m0 0l-4 4m4-4H3" />
				</svg>
			</a>
		</div>
	</div>
</section>