---
import { WA_LINK } from "../lib/site";
import Rabbit3D from "./Rabbit3D.astro";

const features = ["Automatización", "Software a medida", "Datos & IA", "Llave en mano"];
---

<section
	id="hero"
	class="noise-overlay relative flex min-h-svh items-center justify-center overflow-hidden bg-white md:min-h-[90vh]"
	aria-labelledby="hero-title"
>
	<div
		class="pointer-events-none absolute inset-0 bg-gradient-to-br from-white via-lime/5 to-white"
		aria-hidden="true"
	></div>
	<div
		class="pointer-events-none absolute top-20 left-10 h-24 w-24 rounded-full bg-lime/20 blur-3xl"
		aria-hidden="true"
	></div>
	<div
		class="pointer-events-none absolute right-20 bottom-40 h-32 w-32 rounded-full bg-lime/10 blur-3xl"
		aria-hidden="true"
	></div>

	<div class="relative z-10 mx-auto w-full max-w-7xl px-5 pt-24 pb-16 sm:px-6 sm:pt-28 md:pt-32 md:pb-12">
		<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-8">
			<div class="space-y-6">
				<span
					class="inline-flex w-fit items-center gap-2 rounded-full bg-ink px-3 py-1.5 font-mono text-[0.68rem] tracking-widest text-white uppercase"
					data-reveal
				>
					<span class="h-2 w-2 rounded-full bg-lime" aria-hidden="true"></span>
					Consultora tecnológica · IA aplicada
				</span>

				<h1 id="hero-title" class="display lines text-[2.5rem] leading-[1.05] tracking-tighter text-balance text-ink sm:text-5xl md:text-7xl">
					<span class="line">
						<span style="--rd: 0.1s">Automatizamos</span>
					</span>
					<span class="line">
						<span class=" text-lime" style="">Tu empresa</span>
					</span>
				</h1>

				<p
					class="max-w-md font-mono text-base text-ink/60 tracking-tight sm:text-lg md:text-xl"
					data-reveal
					style="--rd: 0.35s"
				>
					Automatización, software y datos — todo potenciado con IA. Soluciones donde la tecnología puede hacer la diferencia y la llevamos a producción.
				</p>

				<div class="flex flex-col items-stretch gap-3 pt-2 sm:flex-row sm:items-center" data-reveal style="--rd: 0.45s">
					<a
						href={WA_LINK}
						target="_blank"
						rel="noopener"
						class="btn btn-lime shine group w-full sm:w-auto"
					>
						Hablemos por WhatsApp
						<svg
							viewBox="0 0 24 24"
							class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M17 8l4 4m0 0l-4 4m4-4H3" />
						</svg>
					</a>
					<a href="#servicios" class="btn btn-outline shine w-full sm:w-auto">Ver cómo trabajamos</a>
				</div>

				<ul class="flex flex-wrap gap-x-5 gap-y-2.5 pt-2" data-reveal style="--rd: 0.55s">
					{features.map((f) => (
						<li class="feature-dot flex items-center gap-2 font-mono text-xs text-ink/60">
							{f}
						</li>
					))}
				</ul>
			</div>

			<div class="relative flex w-full max-w-md justify-center" data-reveal>
				<div class="relative w-full animate-float">
					<div
						class="pointer-events-none absolute inset-0 scale-75 rounded-full bg-lime/30 blur-[80px]"
						aria-hidden="true"
					></div>
					<Rabbit3D class="relative z-10 w-56 drop-shadow-2xl sm:w-64 md:w-80" />
				</div>
			</div>
		</div>

		<div
			class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 md:block"
			aria-hidden="true"
		>
			<div data-reveal>
				<div class="flex w-5 justify-center rounded-full border-2 border-ink/30 pt-1.5">
					<div class="mouse-wheel h-2 w-1 rounded-full bg-ink/30"></div>
				</div>
			</div>
		</div>
	</div>
</section>