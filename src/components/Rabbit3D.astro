---
const {
	class: className = "",
	label = "RabbitIA — conejo de partículas",
	count = 2300,
	background = "dark",
	speed = 1,
	accent = 0.15,
	strength = 0.22,
	size = 0.055,
} = Astro.props;
---

<div
	class:list={["rabbit-3d", className]}
	data-rabbit-3d
	data:count={count}
	data:background={background}
	data:speed={speed}
	data:accent={accent}
	data:strength={strength}
	data:size={size}
	role="img"
	aria-label={label}
	data-reveal
></div>

<script>
	import { mountRabbitScene } from "../three/RabbitScene";

	const container = document.querySelector("[data-rabbit-3d]");
	if (container instanceof HTMLElement) {
		const num = (name: string, fallback: number): number => {
			const raw = container.getAttribute(`data-${name}`);
			const value = raw === null ? fallback : Number(raw);
			return Number.isFinite(value) ? value : fallback;
		};

		mountRabbitScene(container, {
			particleCount: Math.round(num("count", 2300)),
			background: container.getAttribute("data-background") === "transparent" ? "transparent" : "dark",
			speed: num("speed", 1),
			accentRatio: num("accent", 0.15),
			interactionStrength: num("strength", 0.22),
			size: num("size", 0.055),
		});
	}
</script>

<style>
	.rabbit-3d {
		position: relative;
		width: 100%;
		height: 100%;
		min-height: 320px;
		aspect-ratio: 1 / 1;
		touch-action: pan-y;
	}

	.rabbit-3d canvas {
		display: block;
		width: 100% !important;
		height: 100% !important;
	}

	.rabbit-3d--dark {
		border-radius: 50%;
		background: radial-gradient(
			circle at 50% 38%,
			rgba(16, 22, 28, 0.92) 0%,
			rgba(14, 20, 28, 0.78) 52%,
			rgba(10, 14, 20, 0) 100%
		);
		box-shadow: 0 28px 80px -28px rgba(10, 20, 30, 0.55);
	}
</style>