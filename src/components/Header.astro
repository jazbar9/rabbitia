---
import { SITE, WA_LINK } from "../lib/site";
const links = [
	{ href: "/servicios", label: "Servicios" },
	{ href: "/#metodo", label: "Método" },
	{ href: "/#beneficios", label: "Beneficios" },
	{ href: "/#para-quien", label: "Para quién" },
];
---

<a
	href="#main"
	class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-lime focus:text-ink focus:px-4 focus:py-2 focus:text-sm focus:font-bold"
>
	Saltar al contenido
</a>

<header
	id="site-nav"
	class="fixed top-0 left-0 right-0 z-50 bg-transparent transition-all duration-500"
	data-nav
>
	<div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
		<a href="/" class="flex items-center" aria-label={`${SITE.name} — ir al inicio`}>
			<img src="/log-t.png" alt="Logo de la empresa" class="h-10 w-auto md:h-14" />
		</a>

		<nav class="hidden items-center gap-8 lg:flex" aria-label="Navegación principal">
			{links.map((l) => (
				<a
					href={l.href}
					class="nav-link text-sm font-medium tracking-wide text-ink/80 transition-colors hover:text-ink"
				>
					{l.label}
					<span aria-hidden="true"></span>
				</a>
			))}
		</nav>

		<a
			href={WA_LINK}
			target="_blank"
			rel="noopener"
			class="btn btn-lime shine !px-5 !py-2.5 !text-sm"
		>
			<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
				<path d="M12 2a9.93 9.93 0 0 0-8.6 14.98L2 22l5.2-1.36A9.94 9.94 0 1 0 12 2Zm0 2.83a7.11 7.11 0 1 1-3.63 13.22l-.39-.23-3.05.8.81-2.97-.26-.4A7.11 7.11 0 0 1 12 4.83Zm-3.2 3.9c-.18 0-.47.07-.72.33-.24.27-.94.92-.94 2.24s.96 2.6 1.1 2.78c.13.18 1.9 2.9 4.6 4.07 2.28.98 2.74.79 3.24.73.5-.05 1.6-.65 1.83-1.29.22-.63.22-1.17.16-1.29-.07-.11-.25-.18-.52-.32s-1.6-.79-1.85-.88c-.25-.08-.43-.13-.6.13s-.7.88-.86 1.06c-.16.19-.32.21-.6.07a7.7 7.7 0 0 1-2.23-1.37 8.08 8.08 0 0 1-1.54-1.92c-.16-.27-.02-.42.12-.55.13-.13.29-.33.43-.5.14-.17.19-.29.28-.48.09-.19.05-.36-.02-.5s-.6-1.5-.86-2.05c-.22-.52-.45-.45-.62-.46Z" />
			</svg>
			<span class="hidden sm:inline">Cotizar por WhatsApp</span>
			<span class="sm:hidden">Cotizar</span>
		</a>
	</div>
</header>

<script>
	// El nav arranca visible y adquiere fondo blanco al scrollear
	const nav = document.getElementById("site-nav");
	const navLinks = document.querySelectorAll(".nav-link");

	if (nav) {
		let ticking = false;

		const update = () => {
			const y = window.scrollY;

			// Siempre visible
			nav.style.transform = "translateY(0)";

			if (y > 24) {
				nav.classList.remove("bg-transparent");
				nav.classList.add("bg-black/90", "backdrop-blur-md","text-white");
				navLinks.forEach((link) => {
					link.classList.remove("text-ink/80", "hover:text-ink");
					link.classList.add("text-white", "hover:text-white");
				});
			} else {
				nav.classList.add("bg-transparent");
				nav.classList.remove("bg-white/90", "backdrop-blur-md");
				navLinks.forEach((link) => {
					link.classList.remove("text-white", "hover:text-white");
					link.classList.add("text-black", "hover:text-black");
				});
			}

			ticking = false;
		};

		window.addEventListener("scroll", () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		});

		update();
	}
</script>